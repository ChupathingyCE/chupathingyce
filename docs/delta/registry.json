  "advertisement": {
    "description": "the 26 reserved bytes of a host's game advertisement (peer.md, The advertisement). The version word in bytes 0 and 1 says whose layout the rest is: below 0xFF00 the stock layout, 0xFF00 to 0xFFFF Content Evolved's modded games, whose 26 bytes are all Content Evolved's",
    "reserved_size": 26,
    "stock": {
      "flags_byte": 2,
      "flags": [
        {
          "value": 1,
          "name": "distributed",
          "meaning": "the distributed netcode (always set)",
          "for": "the game protocol",
          "status": "in use"
        },
        {
          "value": 2,
          "name": "in_progress",
          "meaning": "the game is under way",
          "for": "the game protocol",
          "status": "in use"
        },
        {
          "value": 4,
          "name": "dedicated",
          "meaning": "a dedicated server (version 39 and later); the old Delta layout's flag before that",
          "for": "the game protocol",
          "status": "in use"
        },
        {
          "value": 8,
          "name": "mcc",
          "meaning": "the host plays the MCC network protocol's join and settings record (peer.md, MCC games)",
          "for": "the MCC network protocol (from GulchCE)",
          "status": "in use, in no Chupathingy release"
        }
      ],
      "bytes": [
        {
          "bytes": [
            0,
            1
          ],
          "name": "version",
          "meaning": "the network version the host announces (little-endian)",
          "for": "the game protocol",
          "status": "in use"
        },
        {
          "bytes": [
            2
          ],
          "name": "flags",
          "meaning": "the flags above",
          "for": "the game protocol",
          "status": "in use"
        },
        {
          "bytes": [
            3
          ],
          "name": "kind",
          "meaning": "the game's kind (version 37 and later), 0 before",
          "for": "the game protocol",
          "status": "in use"
        },
        {
          "bytes": [
            4
          ],
          "name": "mcc_version",
          "meaning": "with the flag 0x08, the MCC network protocol's version",
          "for": "the MCC network protocol (from GulchCE)",
          "status": "in use, in no Chupathingy release"
        },
        {
          "bytes": [
            5,
            16
          ],
          "name": null,
          "meaning": "zero, but for the old Delta layout (peer.md, The old layout)",
          "for": null,
          "status": "reserved"
        },
        {
          "bytes": [
            17,
            25
          ],
          "name": "delta_tag",
