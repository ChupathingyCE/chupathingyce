+                            consumed = true;
+                        }
+                        break;
+
+                    case MotionEvent.ACTION_MOVE:
+                        if (checkRelativeEvent(event)) {
+                            x = getEventX(event, i);
+                            y = getEventY(event, i);
+                            SDLActivity.onNativeMouse(0, action, x, y, true);
+                            consumed = true;
+                        }
+                        break;
+
                     case MotionEvent.ACTION_HOVER_MOVE:
                         x = getEventX(event, i);
