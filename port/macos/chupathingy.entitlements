<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The application's entitlements under the hardened runtime: a build
	signed with a Developer ID (bundle.py with MACOS_SIGNING_IDENTITY, or
	ChupathingyCE's release workflow, which signs and notarizes it with
	this file). Ad hoc builds have no hardened runtime and need none. -->

	<!-- voice chat's microphone (Info.plist's NSMicrophoneUsageDescription
	is what macOS asks the player with) -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- the MCC Workshop's Steam bridge loads a libsteam_api.dylib it finds
	in a game folder under steamapps/common, or the one paths.steam_api /
	HALO_STEAM_API names (steam_bridge_find.c, steam_bridge_api.c), signed
	by whoever made that game, not by us: library validation refuses a
	library of another team ("different Team IDs"). This lets any library
	at those paths load into the signed app; kept on purpose for the bridge. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
