	<widget name="chupathingy/profiles/help" type="text" controller="1" width="290" height="90" string_list="chupathingy/profiles/help_strings" font="ui\large_ui" color="#FF2896FF">
	</widget>
	<strings name="chupathingy/profiles/help_strings">
		<string text="Choose a profile."/>
