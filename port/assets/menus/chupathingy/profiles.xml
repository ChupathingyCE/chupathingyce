	<!-- (deleting one: the Xbox's question, its small B and A prompts) -->
	<widget name="chupathingy/profiles/confirm_delete" width="640" height="480" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\semi_transparent_grey">
		<on event="a" run="final del player profile" close="current"/>
		<on event="start" run="final del player profile" close="current"/>
		<on event="b" run="cancel profile delete" close="current" sound="sound\sfx\ui\back"/>
		<on event="back" run="cancel profile delete" close="current" sound="sound\sfx\ui\back"/>
		<child widget="error/confirm_delete_profile_text_box" x="192" y="176"/>
		<child widget="error/header_warning" x="201" y="180"/>
