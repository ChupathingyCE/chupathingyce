<?xml version="1.0" encoding="UTF-8"?>
<!-- The port's multiplayer screens, in the PC version's style (tools/port_settings.py) -->
<menus>
	<widget name="main_menu/settings_select/multiplayer_setup/player_options_edit/op_hardcore" width="512" height="28" flags="pass_unhandled_to_focused_child" bitmap="bitmaps/option_bkds" color="#FF2896FF">
		<child widget="main_menu/settings_select/multiplayer_setup/player_options_edit/hardcore_label"/>
		<child widget="main_menu/settings_select/multiplayer_setup/player_options_edit/hardcore_spinner" x="320" y="1"/>
	</widget>
	<widget name="main_menu/settings_select/multiplayer_setup/player_options_edit/hardcore_label" type="text" controller="1" width="300" height="22" string_list="main_menu/settings_select/multiplayer_setup/player_options_edit/hardcore_labels" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="4">
	</widget>
	<widget name="main_menu/settings_select/multiplayer_setup/player_options_edit/hardcore_spinner" type="spinner" left="2" top="2" width="148" height="20" flags="pass_unhandled_to_focused_child left_right_tabs_items" string_list="main_menu/settings_select/multiplayer_setup/player_options_edit/var_hardcore" font="ui\large_ui" color="#FF2896FF" align="center" text_y="4" list_flags="items_from_strings" header_bitmap="bitmaps/arrow_sm_left" footer_bitmap="bitmaps/arrow_sm_right" header_bounds="7 -6 19 0" footer_bounds="7 150 19 156">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</widget>
	<strings name="main_menu/settings_select/multiplayer_setup/player_options_edit/hardcore_labels">
		<string text="HARDCORE:"/>
	</strings>
	<strings name="main_menu/settings_select/multiplayer_setup/player_options_edit/var_hardcore">
		<string text="OFF"/>
		<string text="ON"/>
	</strings>
</menus>
