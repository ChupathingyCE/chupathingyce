{
  "expo": {
    "name": "ChupathingyCE",
    "slug": "warthog-ios",
    "version": "0.1.0",
    "scheme": "halo",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1114",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.horrible.chupathingyce"
    },
    "android": {
      "package": "dev.horrible.chupathingyce.launcher",
      "adaptiveIcon": {
        "backgroundColor": "#0d1114",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": ["expo-router"]
  }
}
