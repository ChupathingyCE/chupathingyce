# Another dedicated server on the same host (server/README.md), named by
# the instance (halo-dedicated@team): the same image, with its settings in
# /opt/halo-dedicated/instances/<name>.env and its own data folder
# /opt/halo-dedicated/instances/<name> (saves, debug.txt), the maps (the
# Xbox's and Halo PC's in maps, HaloMD's in md_maps) and playlists the first
# server's, read-only. On the host's network, as the
# first (through a bridge's NAT, hole punching does not reach players behind
# their own), each server's system link on a loopback address of its own
# (HALO_NET_ADDRESS: two cannot share the port on one address).
[Unit]
Description=Halo dedicated server (%i)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
ExecStartPre=-/usr/bin/docker rm -f halo-dedicated-%i
ExecStart=/usr/bin/docker run --rm --name halo-dedicated-%i --network host \
	--user 1000:1000 --cap-drop ALL --security-opt no-new-privileges \
	--memory 1g --pids-limit 256 \
	--env-file /opt/halo-dedicated/instances/%i.env \
	-v /opt/halo-dedicated/instances/%i:/data \
	-v /opt/halo-dedicated/data/maps:/data/maps:ro \
	-v /opt/halo-dedicated/data/md_maps:/data/md_maps:ro \
	-v /opt/halo-dedicated/data/playlists:/data/playlists:ro \
	halo-dedicated
ExecStop=/usr/bin/docker stop -t 10 halo-dedicated-%i
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
