# The dedicated server's settings (server/src/dedicated.c), read by
# halo-dedicated.service. Paths are in the data folder.
HALO_DEDICATED=playlists/small_maps.txt
# (at most 15 characters)
HALO_DEDICATED_NAME=[D] Slayer
HALO_DEDICATED_MINIMUM_PLAYERS=1
HALO_DEDICATED_MAXIMUM_PLAYERS=12
# a game nobody scores in for this many minutes ends (0: never)
HALO_DEDICATED_IDLE_LIMIT=5
# a public game: listed in every OpenCE and ChupathingyCE server browser
# (Join Game > Server Browser) through internet play's brokers; false for
# none (the game list below still lists it)
HALO_DEDICATED_PUBLIC=true
# the game list the server announces to (the default)
HALO_NET_BROWSER=https://halo.milenko.org
# (with more servers on the host, halo-dedicated@.service: system link on a
# loopback address of its own, its announcements to an unused one; internet
# play is unaffected)
HALO_NET_ADDRESS=127.0.0.2
HALO_NET_BROADCAST=127.0.0.254
